rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           in ['admin', 'sheriff', 'deputy'];
    }

    function ticketOwner(ticketId) {
      return get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId;
    }

    // Пользователи
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'user';
      allow update: if isStaff();
      allow delete: if isStaff()
        || (request.auth != null && request.auth.uid == userId);
    }

    // Оценки
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.oderId == request.auth.uid
        && !request.resource.data.keys().hasAny(['adminReply', 'adminReplyBy', 'adminReplyAt']);
      allow update, delete: if request.auth != null && (
        (resource.data.oderId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['adminReply', 'adminReplyBy', 'adminReplyAt']))
        || isStaff()
      );
    }

    // Журнал действий
    match /logs/{logId} {
      allow create: if request.auth != null;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Жители
    match /citizens/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Чёрный список
    match /blacklist/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Обращения к администрации (видны только автору и стаффу)
    match /tickets/{ticketId} {
      allow read: if isStaff()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isStaff());

      match /messages/{msgId} {
        allow read: if isStaff()
          || (request.auth != null && ticketOwner(ticketId) == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.isStaff == isStaff()
          && (isStaff() || ticketOwner(ticketId) == request.auth.uid);
        allow update, delete: if false;
      }
    }
  }
}
